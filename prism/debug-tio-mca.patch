+/*
+ * Debug: print each CA's error state.  Called just before the Fatal TIO panic,
+ * because errdmp can't finish before the box resets.
+ */
+void tioca_dump_error_state(void)
+{
+	struct tioca_kernel *k;
+
+	list_for_each_entry(k, &tioca_list, ca_list) {
+		struct tioca __iomem *ca =
+		    (struct tioca __iomem *)k->ca_common->ca_common.bs_base;
+
+		pr_emerg("CA seg %llx nasid %d: first %llx mult %llx status %llx\n",
+			 k->ca_common->ca_common.bs_persist_segment,
+			 NASID_GET(k->ca_common->ca_common.bs_base),
+			 __sn_readq_relaxed(&ca->ca_first_error),
+			 __sn_readq_relaxed(&ca->ca_mult_error),
+			 __sn_readq_relaxed(&ca->ca_int_status));
+		pr_emerg("CA pcierr_type %llx pcierr_addr %llx gart_err %llx\n",
+			 __sn_readq_relaxed(&ca->ca_pcierr_type),
+			 __sn_readq_relaxed(&ca->ca_pcierr_addr),
+			 __sn_readq_relaxed(&ca->ca_gart_err));
+		pr_emerg("CA crm_pkterr %llx detail1 %llx detail2 %llx tnumto %llx\n",
+			 __sn_readq_relaxed(&ca->ca_crm_pkterr_type),
+			 __sn_readq_relaxed(&ca->ca_crm_ct_error_detail_1),
+			 __sn_readq_relaxed(&ca->ca_crm_ct_error_detail_2),
+			 __sn_readq_relaxed(&ca->ca_crm_tnumto));
+		pr_emerg("CA status1 %llx status2 %llx\n",
+			 __sn_readq_relaxed(&ca->ca_status1),
+			 __sn_readq_relaxed(&ca->ca_status2));
+	}
+}
