 		return -EINVAL;
-	}
 
 	table = (u64 *)bridge->gatt_table;
 
@@ -240,9 +275,9 @@ static struct agp_bridge_data *sgi_tioca_find_bridge(struct pci_dev *pdev)
 
 	list_for_each_entry(bridge, &agp_bridges, list) {
