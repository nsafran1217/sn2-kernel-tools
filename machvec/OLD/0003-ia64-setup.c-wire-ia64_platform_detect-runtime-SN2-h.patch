From 6c427ed1d2a69b6607b402ddc98d4276f4052a71 Mon Sep 17 00:00:00 2001
From: SN2 Dev <sn2-dev@local>
Date: Thu, 23 Apr 2026 15:46:10 +0000
Subject: [PATCH 3/9] ia64: setup.c: wire ia64_platform_detect() + runtime SN2
 hooks

Call ia64_platform_detect() from setup_arch() immediately after
acpi_table_init() and before any platform-conditional code runs
(early_acpi_boot_init, find_memory, cpu_init, ia64_mca_init, the
sn_setup / uv_setup / init_smp_config path).

Convert the two SN2 dispatch sites to runtime when IA64_GENERIC=y:

  * sn_setup / primary_display_setup / uv_setup / init_smp_config
    block at end of setup_arch -> if (ia64_platform_is("sn2"))

  * sn_cpu_init at end of cpu_init -> if (ia64_platform_is("sn2"))

primary_display_setup() is now compiled when IA64_GENERIC is on (so
the non-SN2 runtime branch can call it) as well as in the old
non-SN2 mode.

check_crashkernel_memory() is simplified to the same runtime check;
with the three-mode machvec.h, ia64_platform_is("sn2") already folds
to the right compile-time constant for the two static modes and to
a runtime check for IA64_GENERIC.

Add #include <asm/machvec.h>.
---
 arch/ia64/kernel/setup.c | 41 +++++++++++++++++++++++++++++++---------
 1 file changed, 32 insertions(+), 9 deletions(-)

diff --git a/arch/ia64/kernel/setup.c b/arch/ia64/kernel/setup.c
index 31ac821..469b473 100644
--- a/arch/ia64/kernel/setup.c
+++ b/arch/ia64/kernel/setup.c
@@ -55,6 +55,7 @@
 
 #include <asm/efi.h>
 #include <asm/mca.h>
+#include <asm/machvec.h>
 #include <asm/meminit.h>
 #include <asm/mmu.h>
 #include <asm/page.h>
@@ -267,10 +268,9 @@ __initcall(register_memory);
  */
 static int __init check_crashkernel_memory(unsigned long pbase, size_t size)
 {
-	if (IS_ENABLED(CONFIG_IA64_SGI_SN2) || is_uv_system())
+	if (ia64_platform_is("sn2") || is_uv_system())
 		return 1;
-	else
-		return pbase < (1UL << 32);
+	return pbase < (1UL << 32);
 }
 
 static void __init setup_crashkernel(unsigned long total, int *n)
@@ -510,7 +510,7 @@ early_console_setup (char *cmdline)
 	return (earlycons) ? 0 : -1;
 }
 
-#ifndef CONFIG_IA64_SGI_SN2
+#if !defined(CONFIG_IA64_SGI_SN2) || defined(CONFIG_IA64_GENERIC)
 static void __init
 primary_display_setup(void)
 {
@@ -543,7 +543,7 @@ primary_display_setup(void)
 	sysfb_primary_display.screen.orig_video_isVGA = 1;	/* XXX fake */
 	sysfb_primary_display.screen.orig_video_ega_bx = 3;	/* XXX fake */
 }
-#endif /* !CONFIG_IA64_SGI_SN2 */
+#endif /* !CONFIG_IA64_SGI_SN2 || CONFIG_IA64_GENERIC */
 
 static inline void
 mark_bsp_online (void)
@@ -583,6 +583,16 @@ setup_arch (char **cmdline_p)
 
 	/* Initialize the ACPI boot-time table parser */
 	acpi_table_init();
+
+#ifdef CONFIG_IA64_GENERIC
+	/*
+	 * Must run after acpi_table_init() (so acpi_get_table works) and
+	 * before any ia64_platform_is() caller or platform-conditional
+	 * code path below.
+	 */
+	ia64_platform_detect();
+#endif
+
 	early_acpi_boot_init();
 #ifdef CONFIG_ACPI_NUMA
 	acpi_numa_init();
@@ -643,7 +653,20 @@ setup_arch (char **cmdline_p)
 	 */
 	ROOT_DEV = MKDEV(SCSI_DISK0_MAJOR, 2);
 
-#ifdef CONFIG_IA64_SGI_SN2
+#ifdef CONFIG_IA64_GENERIC
+	if (ia64_platform_is("sn2")) {
+		extern void sn_setup(char **);
+		sn_setup(cmdline_p);
+	} else {
+		if (is_uv_system())
+			uv_setup(cmdline_p);
+#ifdef CONFIG_SMP
+		else
+			init_smp_config();
+#endif
+		primary_display_setup();
+	}
+#elif defined(CONFIG_IA64_SGI_SN2)
 	{
 		extern void sn_setup(char **);
 		sn_setup(cmdline_p);
@@ -657,7 +680,7 @@ setup_arch (char **cmdline_p)
 #endif
 
 	primary_display_setup();
-#endif /* CONFIG_IA64_SGI_SN2 */
+#endif /* CONFIG_IA64_GENERIC / CONFIG_IA64_SGI_SN2 */
 
 
 	clear_sched_clock_stable();
@@ -1086,8 +1109,8 @@ cpu_init (void)
 		ia64_patch_phys_stack_reg(num_phys_stacked*8 + 8);
 		max_num_phys_stacked = num_phys_stacked;
 	}
-#ifdef CONFIG_IA64_SGI_SN2
-	{
+#if defined(CONFIG_IA64_GENERIC) || defined(CONFIG_IA64_SGI_SN2)
+	if (ia64_platform_is("sn2")) {
 		extern void sn_cpu_init(void);
 		sn_cpu_init();
 	}
