diff --git a/arch/ia64/kernel/jump_label.c b/arch/ia64/kernel/jump_label.c
new file mode 100644
index 0000000..6030871
--- /dev/null
+++ b/arch/ia64/kernel/jump_label.c
@@ -0,0 +1,190 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * IA-64 jump label support.
+ *
+ * A jump label site is one 16-byte MIB-template bundle.  The 41-bit
+ * slot-2 encoding is either nop.b 0 (default/off state) or a
+ * br.cond.sptk.many target (on state).  The bundle template stays
+ * the same for both forms, so transforms only rewrite slot 2, which
+ * lives entirely in the high qword of the bundle: one 8-byte store
+ * followed by the standard fc / sync.i / srlz.i icache sync that
+ * the rest of arch/ia64 already uses for self-modifying code
+ * (see ia64_patch_vtop() and ia64_patch_rse() in kernel/patch.c).
+ *
+ * Copyright (C) 2026 SN2 Revival Project
+ */
+
+#include <linux/cpu.h>
+#include <linux/jump_label.h>
+#include <linux/kernel.h>
+#include <linux/memory.h>
+#include <linux/mutex.h>
+#include <linux/smp.h>
+#include <linux/types.h>
+
+#include <asm/cacheflush.h>
+#include <asm/patch.h>
+
+/*
+ * nop.b 0 (B9 form) encoding:
+ *
+ *   bits  40..37  major opcode   = 0x2  (B-unit misc)
+ *   bit   36      reserved       = 0
+ *   bits  35..33  opcode x6 ext  = 0    (pr=0 variant)
+ *   bits  32..13  imm20          = 0
+ *   bits  12..6   reserved       = 0
+ *   bit   5       btype/ext bit  = 0
+ *   bits  5..0    qp             = 0
+ *
+ * Resulting 41-bit value: 0x4000000000 (op=0x2 shifted to bits 40..37
+ * gives 0x2 << 37 = 0x4000000000).
+ */
+#define IA64_NOP_B_SLOT		0x4000000000UL
+
+/*
+ * br.cond.sptk.many target (B1 form) slot-2 encoding.
+ *
+ * The constant bits below were verified against GAS output: a small
+ * test .S file with bundles { nop.m 0; nop.i 0; br.cond.sptk.many T ;;}
+ * at displacements of +1, +2, -1, and +4096 bundles was assembled and
+ * the slot-2 bits inspected.  In every case GAS emits:
+ *
+ *   bits  40..37  major opcode   = 0x4  (branch IP-relative, B1 form)
+ *   bit   36      s              = sign of bundle displacement
+ *   bits  35..33  reserved       = 0
+ *   bits  32..13  imm20b         = (target - bundle_ip) / 16,
+ *                                  low 20 bits of a signed 21-bit disp
+ *   bit   12      completer      = 1  (distinguishes .many from .few)
+ *   bits  11..0   completers etc = 0  (btype=cond, bwh=sptk, qp=0, ...)
+ *
+ * The exact semantic of each bit below 13 in the B1 encoding is not
+ * essential here -- what matters is that this constant plus the
+ * computed (s,imm20b) matches what GAS produces for the same branch.
+ * That equivalence is what makes the patched branch valid.
+ */
+#define IA64_BR_COND_SPTK_BITS	((0x4UL << 37) | (1UL << 12))
+
+/*
+ * ia64_encode_br_cond - build a B1 "br.cond.sptk.many" slot encoding
+ * @bundle_ip: absolute address of the target bundle (16-byte aligned)
+ * @target:    absolute address of the branch target (16-byte aligned)
+ *
+ * Returns the 41-bit slot encoding as a u64, or 0 on out-of-range.
+ * The branch displacement is (target - bundle_ip) expressed in bundles,
+ * as a signed 21-bit value (s:imm20b).  The addressable range is
+ * therefore +/- 16 MiB around bundle_ip.  For in-kernel static branch
+ * sites this is essentially always sufficient.
+ */
+static u64 ia64_encode_br_cond(u64 bundle_ip, u64 target)
+{
+	s64 disp = (s64)(target - bundle_ip);
+	s64 bundles = disp >> 4;
+	u64 imm20b, s;
+
+	if (disp & 0xf) {
+		/* Target must be bundle-aligned.  */
+		return 0;
+	}
+
+	if (bundles < -(1L << 20) || bundles >= (1L << 20)) {
+		/* Out of +/- 16 MiB range; caller must handle.  */
+		return 0;
+	}
+
+	s = (bundles < 0) ? 1UL : 0UL;
+	imm20b = (u64)bundles & ((1UL << 20) - 1);
+
+	return IA64_BR_COND_SPTK_BITS | (s << 36) | (imm20b << 13);
+}
+
+/*
+ * Write a new 41-bit encoding into slot 2 of the bundle at @bundle_ip.
+ * Slot 2 occupies bits 23..63 of b[1] (the high qword of the bundle):
+ *   shift = 5 (template) + 41 * 2 = 87   -> shift-64 = 23
+ *   width = 41                           -> mask in b[1]: bits 63..23
+ */
+static void ia64_patch_slot2(u64 bundle_ip, u64 new_slot_enc)
+{
+	const u64 slot2_mask_b1 = ((1UL << 41) - 1) << 23;
+	u64 *b = (u64 *)(bundle_ip & ~0xfUL);
+
+	b[1] = (b[1] & ~slot2_mask_b1) |
+	       ((new_slot_enc & ((1UL << 41) - 1)) << 23);
+}
+
+static void ia64_jump_label_do_transform(struct jump_entry *entry,
+					 enum jump_label_type type)
+{
+	u64 bundle_ip = jump_entry_code(entry);
+	u64 target    = jump_entry_target(entry);
+	u64 enc;
+
+	if (type == JUMP_LABEL_JMP) {
+		enc = ia64_encode_br_cond(bundle_ip, target);
+		if (!enc) {
+			WARN_ONCE(1,
+				  "ia64 jump_label: target %lx out of range of bundle %lx\n",
+				  (unsigned long)target,
+				  (unsigned long)bundle_ip);
+			return;
+		}
+	} else {
+		enc = IA64_NOP_B_SLOT;
+	}
+
+	ia64_patch_slot2(bundle_ip, enc);
+
+	/* Standard ia64 self-modifying-code icache sync on local CPU. */
+	ia64_fc((void *)bundle_ip);
+	ia64_sync_i();
+	ia64_srlz_i();
+}
+
+/*
+ * Cross-CPU icache sync.  After the local CPU has written the new
+ * bundle and issued fc + sync.i + srlz.i, every other CPU that may
+ * have the stale bundle cached in its I-cache needs to execute
+ * srlz.i before it can be trusted to fetch the new instruction.
+ *
+ * The local_flush_icache_range path already does this for module
+ * load on SMP.  We reuse the same pattern here via smp_call_function.
+ */
+static void ia64_jump_label_icache_sync_each_cpu(void *info)
+{
+	ia64_sync_i();
+	ia64_srlz_i();
+}
+
+void arch_jump_label_transform(struct jump_entry *entry,
+			       enum jump_label_type type)
+{
+	ia64_jump_label_do_transform(entry, type);
+
+#ifdef CONFIG_SMP
+	/*
+	 * Kick every other online CPU through a serialization so any
+	 * stale I-cache copy of the old bundle is discarded before its
+	 * next fetch from that bundle.
+	 */
+	smp_call_function(ia64_jump_label_icache_sync_each_cpu, NULL, 1);
+#endif
+}
+
+/*
+ * arch_jump_label_transform_queue / _apply are optional; providing
+ * them lets the core batch multiple transforms under a single
+ * stop-machine-like window.  We implement the queue as an immediate
+ * transform and make _apply a no-op.  This keeps parity with the
+ * pre-queue API behavior and avoids introducing a dedicated IPI
+ * batching path on ia64 for the single use case we have today.
+ */
+bool arch_jump_label_transform_queue(struct jump_entry *entry,
+				     enum jump_label_type type)
+{
+	arch_jump_label_transform(entry, type);
+	return true;
+}
+
+void arch_jump_label_transform_apply(void)
+{
+}
diff --git a/arch/ia64/kernel/machvec.c b/arch/ia64/kernel/machvec.c
new file mode 100644
index 0000000..7025e40
--- /dev/null
+++ b/arch/ia64/kernel/machvec.c
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Minimal runtime machine vector shim for IA-64.
+ *
+ * Exposes one static key, sn2_platform_key, that is enabled at boot
+ * by ia64_platform_detect() when SN2 (SGI Altix) hardware is detected
+ * via the ACPI XSDT/RSDT OEM ID ("SGI").
+ *
+ * Platform-conditional code paths (I/O, mmiowb, IPI, TLB purge, SN2
+ * init hooks) dispatch on this key whenever CONFIG_IA64_SGI_SN2 is
+ * built in.  Without HAVE_ARCH_JUMP_LABEL on IA-64, static_branch
+ * falls back to a global-variable load + test + branch; once arch
+ * jump-label support lands, the dispatch becomes a patched nop/branch
+ * with no data dependency on the fast path.
+ *
+ * Copyright (C) 2026 SN2 Revival Project
+ */
+
+#include <linux/acpi.h>
+#include <linux/efi.h>
+#include <linux/export.h>
+#include <linux/init.h>
+#include <linux/jump_label.h>
+#include <linux/kernel.h>
+#include <linux/printk.h>
+#include <linux/string.h>
+
+#include <asm/machvec.h>
+
+/*
+ * Populated at boot by ia64_platform_detect() so that existing code
+ * reading this variable (e.g. /proc display, diagnostic messages)
+ * keeps seeing the detected platform name.  The canonical runtime
+ * source of truth for platform checks is the sn2_platform_key
+ * static key, not this string.
+ */
+extern char ia64_platform_name[64];
+
+/*
+ * Default OFF.  A non-SN2 boot leaves the key disabled and the
+ * generic ia64 fast paths run.  ia64_platform_detect() flips the
+ * key on iff we are on SN2 hardware.
+ */
+DEFINE_STATIC_KEY_FALSE(sn2_platform_key);
+EXPORT_SYMBOL_GPL(sn2_platform_key);
+
+/*
+ * ia64_platform_detect - set sn2_platform_key based on ACPI OEM ID
+ *
+ * Called from setup_arch() right after efi_init() / io_port_init() /
+ * uv_probe_system_type() and BEFORE early_console_setup().  The SN2
+ * early console hook (sn_serial_console_early_setup) calls
+ * ia64_platform_is("sn2"), so the static key must already reflect
+ * the detected platform by then.
+ *
+ * We read the XSDT header's OEM ID directly from the EFI config
+ * table (the same approach uv_probe_system_type() uses), rather
+ * than going through ACPICA's acpi_get_table().  ACPICA has not
+ * run acpi_table_init() yet at this point, and we want to be the
+ * very first thing that runs after efi_init().
+ */
+void __init ia64_platform_detect(void)
+{
+	struct acpi_table_rsdp *rsdp;
+	struct acpi_table_xsdt *xsdt;
+	const char *name = "dig";
+
+	if (efi.acpi20 == EFI_INVALID_TABLE_ADDR) {
+		pr_info("ia64: platform detection: no ACPI 2.0 RSDP, assuming generic\n");
+		goto out;
+	}
+
+	rsdp = (struct acpi_table_rsdp *)__va(efi.acpi20);
+	if (strncmp(rsdp->signature, ACPI_SIG_RSDP,
+		    sizeof(ACPI_SIG_RSDP) - 1)) {
+		pr_info("ia64: platform detection: bad RSDP signature, assuming generic\n");
+		goto out;
+	}
+
+	xsdt = (struct acpi_table_xsdt *)__va(rsdp->xsdt_physical_address);
+	if (strncmp(xsdt->header.signature, ACPI_SIG_XSDT,
+		    sizeof(ACPI_SIG_XSDT) - 1)) {
+		pr_info("ia64: platform detection: bad XSDT signature, assuming generic\n");
+		goto out;
+	}
+
+	if (!strncmp(xsdt->header.oem_id, "SGI", 3) &&
+	    strncmp(xsdt->header.oem_table_id + 4, "UV", 2)) {
+		/* SGI OEM ID, not a UV system -> SN2 (Altix). */
+		static_branch_enable(&sn2_platform_key);
+		name = "sn2";
+		pr_info("ia64: platform detected: SN2 (OEM ID '%.6s')\n",
+			xsdt->header.oem_id);
+	} else {
+		pr_info("ia64: platform detected: generic (OEM ID '%.6s')\n",
+			xsdt->header.oem_id);
+	}
+
+out:
+	strscpy(ia64_platform_name, name, sizeof(ia64_platform_name));
+}
