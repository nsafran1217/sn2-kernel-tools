diff --git a/arch/ia64/include/asm/jump_label.h b/arch/ia64/include/asm/jump_label.h
new file mode 100644
index 0000000..5d28ae8
--- /dev/null
+++ b/arch/ia64/include/asm/jump_label.h
@@ -0,0 +1,79 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+#ifndef _ASM_IA64_JUMP_LABEL_H
+#define _ASM_IA64_JUMP_LABEL_H
+
+/*
+ * IA-64 jump label support.
+ *
+ * Each static branch site occupies one 16-byte instruction bundle.
+ * The bundle template is fixed to MIB (template = 0x10) across both
+ * states so that the "off" (nop) and "on" (branch) forms differ only
+ * in the 41-bit slot-2 encoding.  No template rewrite is required, so
+ * the runtime patch is a single 8-byte store to the high qword of the
+ * bundle, followed by the standard fc / sync.i / srlz.i sequence
+ * that the rest of arch/ia64 already uses for self-modifying code.
+ *
+ * asm goto emits the bundle inside its own {} bundle group so the
+ * assembler places the nop.b / br.cond in slot 2 of an MIB bundle
+ * whose slots 0 and 1 are nop.m / nop.i.  This guarantees that the
+ * site is exactly one bundle, 16-byte aligned, and independent of
+ * surrounding code scheduling.
+ */
+#ifndef __ASSEMBLY__
+
+#include <linux/stringify.h>
+#include <linux/types.h>
+
+#define JUMP_LABEL_NOP_SIZE	16
+
+static __always_inline bool arch_static_branch(struct static_key *key,
+					       bool branch)
+{
+	asm goto("1:\n\t"
+		 "{ nop.m 0; nop.i 0; nop.b 0 ;; }\n\t"
+		 ".pushsection __jump_table,  \"aw\"\n\t"
+		 ".align 8\n\t"
+		 ".quad 1b, %l[l_yes], %c0\n\t"
+		 ".popsection\n\t"
+		 : :  "i" (&((char *)key)[branch]) : : l_yes);
+	return false;
+l_yes:
+	return true;
+}
+
+static __always_inline bool arch_static_branch_jump(struct static_key *key,
+						    bool branch)
+{
+	asm goto("1:\n\t"
+		 "{ nop.m 0; nop.i 0; br.cond.sptk.many %l[l_yes] ;; }\n\t"
+		 ".pushsection __jump_table,  \"aw\"\n\t"
+		 ".align 8\n\t"
+		 ".quad 1b, %l[l_yes], %c0\n\t"
+		 ".popsection\n\t"
+		 : : "i" (&((char *)key)[branch]) : : l_yes);
+	return false;
+l_yes:
+	return true;
+}
+
+#endif /* __ASSEMBLY__ */
+
+/*
+ * Non-relative entries: absolute 64-bit code/target/key.  This matches
+ * what <linux/jump_label.h> expects when HAVE_ARCH_JUMP_LABEL_RELATIVE
+ * is not set.  ia64 has no KASLR and a simple virtual address space,
+ * so absolute entries are the simplest correct choice for v1.
+ */
+#ifndef __ASSEMBLY__
+
+typedef u64 jump_label_t;
+
+struct jump_entry {
+	jump_label_t code;
+	jump_label_t target;
+	jump_label_t key;
+};
+
+#endif /* __ASSEMBLY__ */
+
+#endif /* _ASM_IA64_JUMP_LABEL_H */
