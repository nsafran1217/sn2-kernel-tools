 arch/ia64/include/asm/jump_label.h |  79 ++++++++++++
 arch/ia64/kernel/Makefile          |   1 +
 arch/ia64/kernel/jump_label.c      | 187 +++++++++++++++++++++++++++++
 4 files changed, 268 insertions(+)
 create mode 100644 arch/ia64/include/asm/jump_label.h
