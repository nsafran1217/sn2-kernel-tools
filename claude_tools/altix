def cmd_l2(a):
    out, ok = l2_command(" ".join(a.command), timeout=a.timeout)
    print(out)
    return 0 if ok else 1

def cmd_power(a):
    cmd = {"status": "pwr", "up": "pwr u", "down": "pwr d"}[a.state]
    out, ok = l2_command(cmd, timeout=120)
    print(out)
    return 0 if ok else 1

def cmd_reset(a):
    out, ok = l2_command("rst", timeout=60)
    print(out)
    return 0 if ok else 1

def cmd_console(a):
    if a.op == "_run":
        os.makedirs(LOG_DIR, exist_ok=True)
        ConsoleLogger().run()
        return 0
    if a.op == "start":
        console_start()
    elif a.op == "stop":
        pid = console_pid()
        if not pid:
            print("console logger not running")
        else:
            os.kill(pid, signal.SIGTERM)
            print("stopped console logger (pid %d)" % pid)
    elif a.op == "status":
        pid = console_pid()
        print("running (pid %d)" % pid if pid else "not running")
        print("log: %s (%d bytes)" % (CONSOLE_LOG, log_size()))
        return 0 if pid else 1
    elif a.op == "send":
        data = " ".join(a.args)
        data = data.encode("latin1").decode("unicode_escape").encode("latin1") if a.raw else data.encode()
        if not a.raw:
            data += b"\r"
        console_ctl(b"S" + data)
    elif a.op == "mark":
        console_ctl(("M" + " ".join(a.args)).encode())
    elif a.op == "tail":
        lines = read_log_from(0).rstrip("\n").split("\n") if log_size() else []
        for l in lines[-a.n:]:
            print(l)
        if a.follow:
            subprocess.call(["tail", "-n0", "-F", CONSOLE_LOG])
    elif a.op == "since-mark":
        text = read_log_from(0) if log_size() else ""
        key = "### MARK " + " ".join(a.args)
        idx = text.rfind(key)
        if idx < 0:
            die("no mark matching %r" % key)
        print(text[text.rfind("\n", 0, idx) + 1:], end="")
    elif a.op == "wait":
        pats = {"match": re.compile(" ".join(a.args))}
        name, line, _ = wait_log(pats, log_size(), a.timeout)
        if name:
            print(line)
            return 0
        print("timeout", file=sys.stderr)
        return 1
    return 0

def cmd_l3(a):
    if a.op == "start-l2":
        return ssh_l3(L3_L2_START).returncode
    if a.op == "stop-l2":
        return ssh_l3(L3_L2_STOP).returncode
    if a.op == "status":
        return ssh_l3("pgrep -lx l2 || echo 'l2 not running'; tail -5 ~/l2.log").returncode
    if a.op == "run":
        return ssh_l3(" ".join(a.args)).returncode
    return 1

def cmd_errdmp(a):
    before = set(os.listdir(ERRDMP_DIR)) if os.path.isdir(ERRDMP_DIR) else set()
    args = a.args[1:] if a.args[:1] == ["--"] else a.args
    extra = " ".join(args) if args else "-ii"
    print("running on L3: errdmp --l2 %s %s" % (IST_L2, extra), file=sys.stderr)
    rc = ssh_l3("errdmp --l2 %s %s </dev/null" % (IST_L2, extra), timeout=a.timeout).returncode
    after = set(os.listdir(ERRDMP_DIR)) if os.path.isdir(ERRDMP_DIR) else set()
    new = sorted(after - before, key=lambda f: os.path.getmtime(os.path.join(ERRDMP_DIR, f)))
    if new:
        path = os.path.join(ERRDMP_DIR, new[-1])
        if a.name:
            dst = path + "-" + a.name
            os.rename(path, dst)
            path = dst
        print("errdmp output: %s" % path)
        if not a.no_summary:
            print(errdmp_summary(path))
    else:
        print("errdmp: no new dump file in %s" % ERRDMP_DIR, file=sys.stderr)
    return rc

def errdmp_summary(path):
    """Triage view of an errdmp log: flagged registers (minus known noise),
    alerts, CPU LED state, and the Final Error / FRU summaries."""
    text = open(path, errors="replace").read()
    lines = text.split("\n")
    out = ["== %s" % path]
    flagged = [l for l in lines if "<<<<<<<" in l]
    real = [l for l in flagged if not ERRDMP_NOISE.search(l)]
    out.append("-- flagged registers: %d (%d known-normal noise hidden)"
               % (len(real), len(flagged) - len(real)))
    out += ["   " + l.strip() for l in real]
    alerts = list(dict.fromkeys(l.strip() for l in lines
                                if re.search(r"\bALERT\b|^\s*Alert:", l)))
    if alerts:
        out.append("-- alerts:")
        out += ["   " + l for l in alerts]
    # SHub PI CRBs (processor side, not PIC buffers). errdmp's own
    # "Deallocated WRB count != 20" check looks for a boot-PROM signature and
    # reads 0 on every running system; busy (non-FREE) entries are what matter.
    crbs = re.findall(r"^\S+: (RRB|WRB|IRB|PRB)\[ *\d+\].*?STATE=0x[0-9A-Fa-f]+ \(([A-Z_ ]*)\)", text, re.M)
    if crbs:
        tally = {}
        for kind, state in crbs:
            t = tally.setdefault(kind, [0, 0])
            t[0] += 1
            t[1] += state != "FREE"
        out.append("-- SHub PI CRBs busy/total: " + "  ".join(
            "%s %d/%d" % (k, tally[k][1], tally[k][0]) for k in ("RRB", "WRB", "IRB", "PRB") if k in tally))
        busy = [l.strip() for l in lines
                if re.match(r"^\S+: (RRB|WRB|IRB|PRB)\[", l) and "(FREE)" not in l]
        out += ["   " + l[:220] for l in busy]
    m = re.search(r"->Recording LED status.*?\n(.*?)\n<<<<", text, re.S)
    if m:
        leds = [l.rstrip() for l in m.group(1).split("\n") if re.search(r"0x[0-9a-fA-F]{2}:", l)]
        out.append("-- CPU LEDs:")
        out += ["   " + l.strip() for l in leds]
    m = re.search(r"^Final Error Summary\.(.*?)(?=^Memory Configuration Summary|^Final L1 Error Summary|\Z)",
                  text, re.S | re.M)
    if m:
        body = re.sub(r"\n{3,}", "\n\n", m.group(1)).strip("\n")
        out.append("-- Final Error Summary:")
        out.append(body)
    return "\n".join(out)

def latest_errdmp():
    files = [os.path.join(ERRDMP_DIR, f) for f in os.listdir(ERRDMP_DIR)]
    files = [f for f in files if os.path.isfile(f)]
    if not files:
        die("no dumps in %s" % ERRDMP_DIR)
    return max(files, key=os.path.getmtime)

def cmd_errdmp_summary(a):
    for f in a.files or [latest_errdmp()]:
        print(errdmp_summary(f))
    return 0

def cmd_mmr(a):
    chip = CHIP_ALIASES.get(a.chip, a.chip)
    regs = " ".join(a.regs)
    return ssh_l3("mmr_dump -chip %s --l2 %s -n '%s' </dev/null" % (chip, IST_L2, regs),
                  timeout=a.timeout).returncode

def cmd_watch(a):
    """Block until the console shows a panic/oops/MCA (exit 1) or the timeout
    expires with the box still healthy (exit 0)."""
    console_start(quiet=True)
    offset = log_size()
    if a.label:
        console_ctl(("Mwatch " + a.label).encode())
    name, line, _ = wait_log(FAIL_PATTERNS, offset, a.timeout)
    if not name:
        print("no crash within %ds" % a.timeout)
        return 0
    print("CRASH (%s): %s" % (name, strip_ts(line)))
    time.sleep(a.settle)
    seg = read_log_from(offset).rstrip("\n").split("\n")
    print("---- last %d console lines ----" % a.tail)
    print("\n".join(strip_ts(l) for l in seg[-a.tail:]))
    if a.errdmp:
        tag = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
        cmd_errdmp(argparse.Namespace(args=["-ii"], timeout=1800, no_summary=False,
                                      name="%s-%s" % (name, a.label or tag)))
    return 1

def cmd_ssh(a):
    return ssh_target(" ".join(a.command)).returncode

def cmd_wait_ssh(a):
    end = time.time() + a.timeout
    while time.time() < end:
        k = target_up()
        if k:
            print(k)
            return 0
        time.sleep(10)
    print("timeout waiting for ssh to %s" % TARGET_SSH, file=sys.stderr)
    return 1

def main():
    p = argparse.ArgumentParser(prog="altix", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)

    s = sp.add_parser("l2", help="run an L2 command and print the output")
    s.add_argument("--timeout", type=int, default=30)
    s.add_argument("command", nargs="+")
    s.set_defaults(fn=cmd_l2)

    s = sp.add_parser("power", help="power status/up/down")
    s.add_argument("state", choices=["status", "up", "down"], nargs="?", default="status")
    s.set_defaults(fn=cmd_power)

    s = sp.add_parser("reset", help="reset the brick")
    s.set_defaults(fn=cmd_reset)

    s = sp.add_parser("console", help="system console logger and input")
    s.add_argument("op", choices=["start", "stop", "status", "send", "mark", "tail",
                                  "since-mark", "wait", "_run"])
    s.add_argument("args", nargs="*")
    s.add_argument("-n", type=int, default=50, help="tail: number of lines")
    s.add_argument("-f", "--follow", action="store_true", help="tail: follow")
    s.add_argument("--raw", action="store_true",
                   help="send: no trailing CR; interpret \\xNN / \\r escapes")
    s.add_argument("--timeout", type=int, default=300, help="wait: seconds")
    s.set_defaults(fn=cmd_console)

    s = sp.add_parser("boot", help="power up (or reset) and wait for the box to come up")
    s.add_argument("action", choices=["auto", "reboot", "reset", "power-cycle"], nargs="?",
                   default="auto",
                   help="auto: power up if off, ssh reboot if up, otherwise L2 reset")
    s.add_argument("--timeout", type=int, default=1200)
    s.add_argument("--settle", type=int, default=15,
                   help="seconds to keep logging after a panic/MCA match")
    s.add_argument("--tail", type=int, default=60)
    s.add_argument("--label", default="", help="text for the console log marker")
    s.add_argument("--panic", type=int, metavar="N",
                   help="after boot, set kernel.panic=N (0 = hang on panic, for errdmp)")
    s.set_defaults(fn=boot_cycle)

    s = sp.add_parser("l3", help="manage the software L2 on the L3 / run commands there")
    s.add_argument("op", choices=["start-l2", "stop-l2", "status", "run"])
    s.add_argument("args", nargs="*")
    s.set_defaults(fn=cmd_l3)

    s = sp.add_parser("errdmp", help="run errdmp on the L3 (default args: -ii)")
    s.add_argument("--name", help="suffix to append to the dump file name")
    s.add_argument("--no-summary", action="store_true", help="don't print the triage summary")
    s.add_argument("--timeout", type=int, default=1800)
    s.add_argument("args", nargs=argparse.REMAINDER)
    s.set_defaults(fn=cmd_errdmp)

    s = sp.add_parser("errdmp-summary", help="triage summary of errdmp logs (default: newest)")
    s.add_argument("files", nargs="*")
    s.set_defaults(fn=cmd_errdmp_summary)

    s = sp.add_parser("mmr", help="mmr_dump SHub registers via JTAG (chip: shub or full name)")
    s.add_argument("--timeout", type=int, default=600)
    s.add_argument("chip")
    s.add_argument("regs", nargs="+")
    s.set_defaults(fn=cmd_mmr)

    s = sp.add_parser("watch", help="wait for a panic/oops/MCA on the console")
    s.add_argument("--timeout", type=int, default=3600)
    s.add_argument("--settle", type=int, default=20,
                   help="seconds to keep logging after the first match")
    s.add_argument("--tail", type=int, default=80)
    s.add_argument("--errdmp", action="store_true", help="run errdmp -ii after a crash")
    s.add_argument("--label", default="")
    s.set_defaults(fn=cmd_watch)

    s = sp.add_parser("ssh", help="run a command on the target as root")
    s.add_argument("command", nargs="+")
    s.set_defaults(fn=cmd_ssh)

    s = sp.add_parser("wait-ssh", help="wait until the target answers ssh")
    s.add_argument("--timeout", type=int, default=900)
    s.set_defaults(fn=cmd_wait_ssh)

    a, extra = p.parse_known_args()
    if extra:
        if a.cmd != "errdmp":
            p.error("unrecognized arguments: %s" % " ".join(extra))
        a.args = extra + a.args
    try:
        sys.exit(a.fn(a) or 0)
    except KeyboardInterrupt:
        sys.exit(130)

if __name__ == "__main__":
    main()
